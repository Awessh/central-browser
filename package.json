{
  "name": "central-browser",
  "version": "1.0.7",
  "description": "Navigateur web multi-fonction",
  "main": "main.js",
  "author": "Awesshhh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.browser.centralbrowser",
    "productName": "Central Browser",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Awessh",
        "repo": "central-browser",
        "releaseType": "release",
        "private": true
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "index.html",
      "preloader.js",
      "preloader.css",
      "renderer/**",
      "fontawesome/**",
      "assets/**",
      "styles.css",
      "styles-extra.css",
      "build/**",
      "pdfjs/**",
      "players/**",
      "pdf-manager/**",
      "file-transfer/**",
      "medias/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Central Browser",
      "license": "build/license.txt"
    }
  }
}
